{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "24 hours",
  "automerge": true,
  "packageRules": [
    {
      "description": "Go modulesのdigest(疑似バージョン)アップデートを除外",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Go modulesのメジャーアップデートは自動マージしない（モジュールパスの変更にimport・tool指定が追従せず、CIもbootstrapのgo mod tidyで吸収して検知できないため）",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
